<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config para Despliegue en IIS (Opción B: iisnode nativo)
  Ejecuta server.cjs a través del módulo de IIS iisnode dentro del Application Pool.
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- Indica que server.cjs debe ser manejado por el módulo iisnode -->
      <add name="iisnode" path="server.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- No interferir con las rutas internas de depuración de iisnode -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.cjs[/](debug[\/]?)?" />
        </rule>

        <!-- Servir archivos estáticos del bundle dist directamente si existen físicamente -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(assets|images|icons|favicon\.ico|manifest\.json)(.*)" />
          <action type="Rewrite" url="dist/{R:0}" />
        </rule>

        <!-- Todas las demás peticiones (API /api/* y rutas SPA) se canalizan a server.cjs -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.cjs" />
        </rule>
      </rules>
    </rewrite>

    <!-- Configuración del módulo iisnode -->
    <iisnode
      nodeProcessCommandLine="&quot;%ProgramFiles%\nodejs\node.exe&quot;"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      devErrorsEnabled="true"
    />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="backend" />
          <add segment=".git" />
          <add segment=".env" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="15728640" /> <!-- 15 MB para evidencias -->
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
