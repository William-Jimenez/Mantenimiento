      "item": [
        {
          "name": "Health Check API",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Servicio Spring Boot activo', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('UP');",
                  "});"
