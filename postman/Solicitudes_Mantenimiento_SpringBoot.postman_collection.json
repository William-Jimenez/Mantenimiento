                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            }
          }
        },
        {
          "name": "Obtener Catálogos Maestros",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estado HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Incluye estados, categorías, prioridades y técnicos', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('estados');",
                  "    pm.expect(json).to.have.property('categorias');",
                  "    pm.expect(json).to.have.property('prioridades');",
                  "});"
