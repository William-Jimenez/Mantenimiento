<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config para Despliegue en IIS (Opción A: Reverse Proxy con URL Rewrite & ARR)
  Redirige el tráfico entrante al servidor Node.js (Vite Preview / Node Express) o Spring Boot.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Regla de Proxy Inverso hacia el servicio local -->
        <rule name="ReverseProxyToNodeApp" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="15728640" /> <!-- Límite de subida de evidencias: 15 MB -->
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
